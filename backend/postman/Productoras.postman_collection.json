{
  "info": {
    "_postman_id": "dd39c937-b423-4ce4-b602-c52b157a87b6",
    "name": "API REST - Productoras",
    "description": "Solicitudes CRUD para /api/productoras. Ejecuta las solicitudes en orden. DELETE elimina permanentemente la productora de prueba.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Listar productoras",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base_url}}/api/productoras"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200 y devuelve una lista', function () {",
              "    pm.response.to.have.status(200);",
              "    pm.expect(pm.response.json().data).to.be.an('array');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "2. Crear productora de prueba",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const suffix = Date.now().toString() + Math.floor(Math.random() * 10000).toString();",
              "pm.collectionVariables.set('test_nombre', 'Postman ' + suffix);"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 201 y guarda el ID', function () {",
              "    pm.response.to.have.status(201);",
              "    const data = pm.response.json().data;",
              "    pm.expect(data.id).to.exist;",
              "    pm.expect(data.nombre).to.eql(pm.collectionVariables.get('test_nombre'));",
              "    pm.collectionVariables.set('productora_id', data.id);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nombre\": \"{{test_nombre}}\",\n  \"slogan\": \"Slogan de prueba\",\n  \"descripcion\": \"Productora temporal creada desde Postman.\",\n  \"estado\": \"Activo\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{base_url}}/api/productoras"
      }
    },
    {
      "name": "3. Consultar productora por ID",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base_url}}/api/productoras/{{productora_id}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200 y devuelve el ID solicitado', function () {",
              "    pm.response.to.have.status(200);",
              "    pm.expect(pm.response.json().data.id.toString()).to.eql(pm.collectionVariables.get('productora_id').toString());",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "4. Reemplazar productora (PUT)",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nombre\": \"{{test_nombre}} actualizada\",\n  \"slogan\": \"Slogan actualizado\",\n  \"descripcion\": \"Descripción actualizada con PUT.\",\n  \"estado\": \"Inactivo\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{base_url}}/api/productoras/{{productora_id}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200 y actualiza sus campos', function () {",
              "    pm.response.to.have.status(200);",
              "    pm.expect(pm.response.json().data.estado).to.eql('Inactivo');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "5. Actualizar estado (PATCH)",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"estado\": \"Activo\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{base_url}}/api/productoras/{{productora_id}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200 y conserva campos no enviados', function () {",
              "    pm.response.to.have.status(200);",
              "    const data = pm.response.json().data;",
              "    pm.expect(data.estado).to.eql('Activo');",
              "    pm.expect(data.slogan).to.eql('Slogan actualizado');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "6. Eliminar productora de prueba",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": "{{base_url}}/api/productoras/{{productora_id}}",
        "description": "Elimina permanentemente la productora de prueba creada con esta colección."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 204 sin contenido', function () {",
              "    pm.response.to.have.status(204);",
              "    pm.expect(pm.response.text()).to.eql('');",
              "});",
              "pm.collectionVariables.unset('productora_id');"
            ]
          }
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "base_url",
      "value": "http://127.0.0.1:8000",
      "type": "string"
    },
    {
      "key": "productora_id",
      "value": "",
      "type": "string"
    },
    {
      "key": "test_nombre",
      "value": "",
      "type": "string"
    }
  ]
}
