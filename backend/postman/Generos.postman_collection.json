{
  "info": {
    "_postman_id": "5c9df889-197e-41ac-ae47-8ad1a069880b",
    "name": "API REST - Géneros",
    "description": "Solicitudes CRUD para el recurso /api/generos. Crear el género antes de ejecutar las solicitudes que usan {{genero_id}}. DELETE elimina permanentemente el registro.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Listar géneros",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base_url}}/api/generos",
        "description": "Lista los géneros registrados."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Responde HTTP 200', function () { pm.response.to.have.status(200); });",
              "pm.test('Devuelve una lista en data', function () {",
              "    pm.expect(pm.response.json().data).to.be.an('array');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "2. Crear género de prueba",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const suffix = Date.now().toString() + Math.floor(Math.random() * 10000).toString();",
              "pm.collectionVariables.set('test_nombre', 'Postman ' + suffix);"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Responde HTTP 201', function () { pm.response.to.have.status(201); });",
              "const body = pm.response.json();",
              "if (body.data && body.data.id) { pm.collectionVariables.set('genero_id', body.data.id); }",
              "pm.test('Guarda el identificador y devuelve el género', function () {",
              "    pm.expect(body.data.id).to.exist;",
              "    pm.expect(body.data.nombre).to.eql(pm.collectionVariables.get('test_nombre'));",
              "    pm.expect(body.data.estado).to.eql('Activo');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nombre\": \"{{test_nombre}}\",\n  \"estado\": \"Activo\",\n  \"descripcion\": \"Género temporal creado desde Postman.\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{base_url}}/api/generos",
        "description": "Crea un género temporal y guarda su ID para las siguientes solicitudes."
      }
    },
    {
      "name": "3. Consultar género creado",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base_url}}/api/generos/{{genero_id}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Responde HTTP 200', function () { pm.response.to.have.status(200); });",
              "pm.test('Devuelve el género esperado', function () {",
              "    const data = pm.response.json().data;",
              "    pm.expect(data.id.toString()).to.eql(pm.collectionVariables.get('genero_id').toString());",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "4. Reemplazar género (PUT)",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nombre\": \"{{test_nombre}} actualizado\",\n  \"estado\": \"Inactivo\",\n  \"descripcion\": \"Descripción reemplazada con PUT.\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{base_url}}/api/generos/{{genero_id}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Responde HTTP 200 y actualiza los campos', function () {",
              "    pm.response.to.have.status(200);",
              "    const data = pm.response.json().data;",
              "    pm.expect(data.estado).to.eql('Inactivo');",
              "    pm.expect(data.descripcion).to.eql('Descripción reemplazada con PUT.');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "5. Actualizar estado (PATCH)",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"estado\": \"Activo\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{base_url}}/api/generos/{{genero_id}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Responde HTTP 200 y conserva la descripción', function () {",
              "    pm.response.to.have.status(200);",
              "    const data = pm.response.json().data;",
              "    pm.expect(data.estado).to.eql('Activo');",
              "    pm.expect(data.descripcion).to.eql('Descripción reemplazada con PUT.');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "6. Eliminar género de prueba",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": "{{base_url}}/api/generos/{{genero_id}}",
        "description": "Elimina permanentemente el género creado con esta colección."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Responde HTTP 204 sin contenido', function () {",
              "    pm.response.to.have.status(204);",
              "    pm.expect(pm.response.text()).to.eql('');",
              "});",
              "pm.collectionVariables.unset('genero_id');"
            ]
          }
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "base_url",
      "value": "http://127.0.0.1:8000",
      "type": "string"
    },
    {
      "key": "genero_id",
      "value": "",
      "type": "string"
    },
    {
      "key": "test_nombre",
      "value": "",
      "type": "string"
    }
  ]
}
