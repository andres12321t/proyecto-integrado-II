{
  "info": {
    "_postman_id": "7962bcfc-7e80-436e-bcb6-531c5d598f87",
    "name": "API REST - Tipos",
    "description": "Solicitudes CRUD para /api/tipos. Ejecuta las solicitudes en orden. DELETE elimina permanentemente el tipo de prueba.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Listar tipos",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base_url}}/api/tipos"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200 y lista en data', function () {",
              "    pm.response.to.have.status(200);",
              "    pm.expect(pm.response.json().data).to.be.an('array');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "2. Crear tipo de prueba",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const suffix = Date.now().toString() + Math.floor(Math.random() * 10000).toString();",
              "pm.collectionVariables.set('test_nombre', 'Postman ' + suffix);"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 201 y guarda el ID', function () {",
              "    pm.response.to.have.status(201);",
              "    const data = pm.response.json().data;",
              "    pm.expect(data.id).to.exist;",
              "    pm.expect(data.nombre).to.eql(pm.collectionVariables.get('test_nombre'));",
              "    pm.collectionVariables.set('tipo_id', data.id);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nombre\": \"{{test_nombre}}\",\n  \"descripcion\": \"Tipo temporal creado desde Postman.\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{base_url}}/api/tipos"
      }
    },
    {
      "name": "3. Consultar tipo por ID",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base_url}}/api/tipos/{{tipo_id}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200 y devuelve el ID solicitado', function () {",
              "    pm.response.to.have.status(200);",
              "    pm.expect(pm.response.json().data.id.toString()).to.eql(pm.collectionVariables.get('tipo_id').toString());",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "4. Reemplazar tipo (PUT)",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nombre\": \"{{test_nombre}} actualizado\",\n  \"descripcion\": \"Descripción actualizada con PUT.\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{base_url}}/api/tipos/{{tipo_id}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200 y actualiza los campos', function () {",
              "    pm.response.to.have.status(200);",
              "    const data = pm.response.json().data;",
              "    pm.expect(data.nombre).to.eql(pm.collectionVariables.get('test_nombre') + ' actualizado');",
              "    pm.expect(data.descripcion).to.eql('Descripción actualizada con PUT.');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "5. Actualizar descripción (PATCH)",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"descripcion\": \"Descripción actualizada con PATCH.\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": "{{base_url}}/api/tipos/{{tipo_id}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200 y conserva el nombre', function () {",
              "    pm.response.to.have.status(200);",
              "    const data = pm.response.json().data;",
              "    pm.expect(data.descripcion).to.eql('Descripción actualizada con PATCH.');",
              "    pm.expect(data.nombre).to.eql(pm.collectionVariables.get('test_nombre') + ' actualizado');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "6. Eliminar tipo de prueba",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": "{{base_url}}/api/tipos/{{tipo_id}}",
        "description": "Elimina permanentemente el tipo de prueba creado con esta colección."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 204 sin contenido', function () {",
              "    pm.response.to.have.status(204);",
              "    pm.expect(pm.response.text()).to.eql('');",
              "});",
              "pm.collectionVariables.unset('tipo_id');"
            ]
          }
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "base_url",
      "value": "http://127.0.0.1:8000",
      "type": "string"
    },
    {
      "key": "tipo_id",
      "value": "",
      "type": "string"
    },
    {
      "key": "test_nombre",
      "value": "",
      "type": "string"
    }
  ]
}
